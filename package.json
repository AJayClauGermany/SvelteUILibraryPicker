{
  "name": "svelte-ui-library-picker",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Compare Svelte UI libraries side by side: features, Svelte support, components, and links back to the official docs.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vite build --config previews/vite.config.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "validate": "vitest run",
    "verify": "pnpm validate && pnpm check && pnpm build"
  },
  "devDependencies": {
    "@ark-ui/svelte": "5.25.1",
    "@floating-ui/dom": "^1.8.0",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@svar-ui/svelte-core": "2.6.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@sveltepress/theme-default": "^8.11.0",
    "@sveltepress/vite": "^1.10.0",
    "@sveltestrap/sveltestrap": "7.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^24.19.2",
    "bits-ui": "2.20.4",
    "bootstrap": "5.3.8",
    "carbon-components-svelte": "0.113.1",
    "flowbite": "3.1.2",
    "flowbite-svelte": "1.33.1",
    "m3-svelte": "7.2.1",
    "melt": "0.44.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-ux": "1.0.11",
    "tailwindcss": "4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  }
}
